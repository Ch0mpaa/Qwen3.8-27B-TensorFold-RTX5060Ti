# ============================================================
#  Qwen3.8 27B / Flash Next — TensorFold on RTX 5060 Ti (16 GB)
#  by Screwed Up Tech — screwedup.tech
#
#  Copy to .env and edit. Restart the server after changes.
# ============================================================

# --- model selection ------------------------------------------
# Which model to serve. Pick ONE:
#   dense   — Qwen3.8-27B EXL3 2.0bpw (default, 6.8 GB, proven 27.7 tok/s)
#   flashnext — Qwen3.8-Flash-Next EXL3 2.05bpw (62.8 GB, MoE + native MTP)
MODEL=dense

# --- model paths (set by setup, or override) ------------------
# Dense model (EXL3 2.0bpw from Mia-AiLab)
DENSE_MODEL_DIR=models/Qwen3.8-27B-EXL3-2.0bpw
DENSE_HF_REPO=Mia-AiLab/Qwen3.8-27B-EXL3-2.0bpw

# Flash Next model (EXL3 2.05bpw from turboderp)
FLASHNEXT_MODEL_DIR=models/Qwen3.8-Flash-Next-exl3-2.05bpw
FLASHNEXT_HF_REPO=turboderp/Qwen3.8-Flash-Next-exl3
FLASHNEXT_HF_REVISION=2.05bpw_h4_ng4

# --- TensorFold engine ----------------------------------------
# TensorFold venv (created by setup)
TF_VENV=.venv

# --- HTTP -----------------------------------------------------
PORT=8090
HOST=0.0.0.0
# Model name reported by /v1/models
MODEL_ID=qwen3.8-27b-exl3-2bpw-tensorfold

# --- thinking / reasoning -------------------------------------
# Qwen3.8's reasoning chain. Off saves tokens and avoids offsec
# refusals; on gives chain-of-thought.
#   off  — go straight to content (default, 14x faster)
#   on   — think before answering
THINKING=off

# --- speculative decoding (dense model) -----------------------
# Dense Qwen3.8 on CUDA requires DFlash2 (3.8 GB) for spec decode.
# On a 16 GB card DFlash2 does not fit alongside the 2.0 bpw model.
# The MTP head in the checkpoint (50 MB) is used by ExLlamaV3 but
# TensorFold's CUDA engine does not support MTP for dense Qwen3.8.
#   none   — no spec decode, one token a round (default on 16 GB)
DRAFT=none

# --- speculative decoding (Flash Next) ------------------------
# Flash Next has native MTP — no separate drafter needed.
# TensorFold uses it automatically.
#   3-6    — MTP drafts per round on CUDA (default: 6)
MTP_DRAFTS=6
# Stop an MTP chain when confidence drops below this
MTP_CONFIDENCE=0.60

# --- context / KV cache --------------------------------------
# Total context window in tokens.
# Dense 2.0bpw on 14.7 GB budget:
#   3072   — safe default, ~2 KB KV overhead
#   4096   — tight, may OOM with other GPU processes
# Flash Next with SSD offload: up to 32768
CONTEXT_SIZE=3072

# KV cache quantization (EXL3 int path, no GPU requirement).
#   8,4    — int8 keys / int4 values (26 KB/token, validated)
#   4      — int4 (18 KB/token, lossless on Qwen3.8)
#   8      — int8 (34 KB/token)
CACHE_QUANT=4

# --- VRAM budget ----------------------------------------------
# 16 GB cards have ~14.7 GB free after driver + desktop.
# Set lower if other apps (browser, Discord) hold VRAM.
GPU_MEM_GB=14.7

# --- SSD expert offload (Flash Next only) ---------------------
# Flash Next is 62.8 GB total. On 16 GB only active experts fit
# in VRAM; the rest stream from SSD. Needs fast NVMe.
#   0   — all in VRAM (needs 64+ GB)
#   50  — offload up to 50 GB to SSD (default for 16 GB)
SSD_EXPERTS_GIB=50

# N-gram embedding table (26 GB) on SSD instead of VRAM.
# 10-30% slower copy drafts, saves 26 GB VRAM.
PLE_ON_SSD=1

# --- performance flags ----------------------------------------
# Lane kernels: tensor-unit decode for Qwen3.8 dense.
# auto = on for GPUs with tensor cores (5060 Ti has them).
LANE_KERNELS=auto

# Prompt cache: reuse prefilled system prompts across requests.
# 0 = off, N = GiB for cached prefixes.
PROMPT_CACHE_GIB=1

# Skip version check on startup
NO_UPDATE_CHECK=1

# CUDA kernel cache (persist compiled kernels across restarts)
KERNEL_CACHE=cache/kernels

# --- vision ---------------------------------------------------
# Image input (Qwen3.8 vision tower, ~0.3 GB).
#   auto — load if it fits under GPU_MEM_GB
#   off  — text only (saves VRAM for longer context)
VISION=off
